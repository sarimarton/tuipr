{
  "name": "tuipr",
  "version": "0.0.1",
  "description": "Terminal review workstation for agent-generated PRs — budgeted AI review, merge gates, attestation",
  "keywords": [
    "tui",
    "terminal",
    "pull-request",
    "code-review",
    "github",
    "ai-review",
    "merge-queue"
  ],
  "homepage": "https://github.com/sarimarton/tuipr#readme",
  "bugs": {
    "url": "https://github.com/sarimarton/tuipr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarimarton/tuipr.git"
  },
  "license": "MIT",
  "author": "Márton Sári",
  "type": "module",
  "bin": {
    "tuipr": "bin/tuipr.mjs",
    "tuigh": "bin/tuipr.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "hunkdiff": ">=0.17",
    "node-pty": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "hunkdiff": {
      "optional": true
    },
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-devtools-core": "^6.1.5"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'",
    "build:binary": "bun build --compile --outfile dist/tuipr bin/tuipr.mjs",
    "check": "node --check bin/tuipr.mjs && node --test 'test/**/*.test.mjs'"
  },
  "engines": {
    "node": ">=20"
  }
}
